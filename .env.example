# ─────────────────────────────────────────────────────────────────────────────
# spotify-music-intelligence · environment variables
# Copy this file to .env and fill in your values. Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Spotify API (required) ────────────────────────────────────────────────────
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback

# ── Lyrics providers (optional — at least one recommended) ───────────────────
# Genius: https://genius.com/api-clients
GENIUS_API_TOKEN=your_genius_api_token_here

# Musixmatch: https://developer.musixmatch.com/
MUSIXMATCH_API_KEY=your_musixmatch_api_key_here

# ── Application settings ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
CACHE_TTL_SECONDS=3600
MAX_RETRIES=3
REQUEST_TIMEOUT=30
